###############################################
# Assistant Core v3 - Environment Variables
# This is the example configuration file.
# Copy it as .env and fill your real secrets.
###############################################

##############################
# APP ENVIRONMENT
##############################
ENV=development      # development | production
ENVIRONMENT=development
BASE_URL=http://localhost:8000  # Base URL for internal API calls
FRONTEND_URL=http://localhost:3000

##############################
# DATABASE CONFIGURATION
##############################
# Primary runtime storage
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=ai_assistant

# Legacy / optional value retained for compatibility with older docs and scripts
DATABASE_URL=sqlite+aiosqlite:///./assistant_core.db

##############################
# API SECURITY
##############################
# API key for authenticating all /api routes
API_KEY=your_api_key_here

# JWT token for merged backend auth
JWT_SECRET_KEY=your_jwt_secret_key_here
AUTH_STORE_MODE=auto   # auto | inmemory

# Fernet symmetric token encryption key for OAuth tokens and credentials
TOKEN_ENCRYPTION_KEY=your_token_encryption_key_here

##############################
# OAUTH 2.0 CONFIGURATION (GOOGLE)
##############################
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Dev Redirect URI: http://localhost:8000/api/oauth/google/callback
# Prod Redirect URI: https://yourdomain.com/api/oauth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:8000/api/oauth/google/callback

##############################
# OAUTH 2.0 CONFIGURATION (MICROSOFT)
##############################
MICROSOFT_CLIENT_ID=your_microsoft_client_id
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret
# Dev Redirect URI: http://localhost:8000/api/oauth/microsoft/callback
# Prod Redirect URI: https://yourdomain.com/api/oauth/microsoft/callback
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/oauth/microsoft/callback
# Tenant ID: common (multi-tenant personal + work) | organizations | consumers | {tenant_guid}
MICROSOFT_TENANT_ID=common

##############################
# OAUTH 2.0 CONFIGURATION (GITHUB)
##############################
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
# Dev Redirect URI: http://localhost:8000/api/oauth/github/callback
# Prod Redirect URI: https://yourdomain.com/api/oauth/github/callback
GITHUB_REDIRECT_URI=http://localhost:8000/api/oauth/github/callback

##############################
# OAUTH 2.0 CONFIGURATION (APPLE)
##############################
APPLE_CLIENT_ID=your_apple_client_id
APPLE_TEAM_ID=your_apple_team_id
APPLE_KEY_ID=your_apple_key_id
APPLE_PRIVATE_KEY=your_apple_private_key
# Dev Redirect URI: http://localhost:8000/api/oauth/apple/callback
# Prod Redirect URI: https://yourdomain.com/api/oauth/apple/callback
APPLE_REDIRECT_URI=http://localhost:8000/api/oauth/apple/callback

##############################
# LOGGING
##############################
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

##############################
# AI SERVICE KEYS
##############################
# Optional ÔÇô provide only if used
OPENAI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
HF_TOKEN=

##############################
# MONITORING
##############################
# Sentry error tracking (optional)
SENTRY_DSN=

# Samachar News-AI Service URL (reusable capability contract)
SAMACHAR_API_URL=http://localhost:8001/api/unified-news-workflow

##############################
# EMAIL / MESSAGING (OPTIONAL)
##############################
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=AI Assistant

##############################
# WHATSAPP (CLOUD API)
##############################
# Set to "cloud" to force Cloud API usage.
WHATSAPP_PROVIDER=cloud
WHATSAPP_CLOUD_ACCESS_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_API_VERSION=v20.0
WHATSAPP_CLOUD_BASE_URL=https://graph.facebook.com

# Webhook verification/signature (Meta App Secret + verify token)
WHATSAPP_WEBHOOK_SECRET=
WHATSAPP_VERIFY_TOKEN=
META_VERIFY_TOKEN=
META_APP_SECRET=

##############################
# WHATSAPP (TWILIO)
##############################
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

##############################
# INBOUND MEDIATION (OPTIONAL)
##############################
INBOUND_MEDIATION_ENABLED=0
INBOUND_MEDIATION_CHANNELS=
INBOUND_MEDIATION_QUIET_HOURS_START=22:00
INBOUND_MEDIATION_QUIET_HOURS_END=07:00
INBOUND_MEDIATION_TZ_OFFSET=UTC
INBOUND_MEDIATION_CONTACT_LIMITS_ENABLED=0
INBOUND_MEDIATION_LIMIT_WHATSAPP=5
INBOUND_MEDIATION_LIMIT_EMAIL=3
INBOUND_MEDIATION_LIMIT_INSTAGRAM=2
INBOUND_MEDIATION_LIMIT_SMS=4

##############################
# OUTBOUND SAFETY GATE
##############################
OUTBOUND_SAFETY_GATE_ENABLED=1

# Samachar News-AI API Configuration
SAMACHAR_API_URL=http://localhost:8001/api/unified-news-workflow

