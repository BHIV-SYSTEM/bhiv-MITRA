{
  "version": 2,
  "buildCommand": "cd frontend/frontend && npm install && CI=false npm run build",
  "outputDirectory": "frontend/frontend/build",
  "rewrites": [
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/api/:path*",
      "destination": "https://mitra-backend.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
